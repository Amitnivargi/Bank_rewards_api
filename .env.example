# .env.example
# ─────────────────────────────────────────
# TEMPLATE showing what variables are needed —
# NO real values here. Safe to commit to Git.
# Anyone cloning this repo copies this to .env
# and fills in their own real values.

DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
JWT_SECRET_KEY=<your-secret-key>
ACCESS_TOKEN_EXPIRE_MINUTES=30
GROQ_API_KEY=<your-groq-api-key>
ENVIRONMENT=development